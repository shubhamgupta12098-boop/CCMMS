# Render supplies PORT automatically. Keep this only for local development.
PORT=5000
NODE_ENV=production

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

FIREBASE_PROJECT_ID=your-real-project-id
FIREBASE_CLIENT_EMAIL=your-real-service-account-email

# Option A: paste JSON private_key as one line with literal \n characters.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_REAL_KEY\n-----END PRIVATE KEY-----\n"

# Option B (recommended on Render): Base64-encode the complete PEM key and use
# this variable instead of FIREBASE_PRIVATE_KEY.
# FIREBASE_PRIVATE_KEY_BASE64=base64_encoded_complete_pem_key

FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# For an Android/Capacitor app, requests may have no browser Origin.
# Use * initially; restrict it later when deploying a browser frontend.
CLIENT_URL=*
